<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kiểm tra tương thích"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#172033"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_build_option">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Cấu hình tương thích"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#16A34A"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kết quả minh họa cho cấu hình PC mẫu"
                android:textColor="#858BA0"
                android:gravity="center"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chi tiết kiểm tra"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ CPU và Mainboard cùng socket"
            android:textSize="16sp"
            android:padding="18dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_build_option"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ RAM tương thích Mainboard"
            android:textSize="16sp"
            android:padding="18dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_build_option"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ Nguồn đáp ứng công suất"
            android:textSize="16sp"
            android:padding="18dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_build_option"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ Case phù hợp kích thước linh kiện"
            android:textSize="16sp"
            android:padding="18dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_build_option"/>

        <TextView
            android:id="@+id/txtCompatibilityTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tổng giá: 20.500.000 VNĐ"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#625DE8"
            android:layout_marginTop="28dp"/>

        <Button
            android:id="@+id/btnAddBuildToCart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Thêm cấu hình vào giỏ hàng"
            android:textAllCaps="false"
            android:backgroundTint="#625DE8"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/btnBackCompatibility"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Quay lại chi tiết"
            android:textAllCaps="false"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
